{% extends "base.html.j2" %}
{% block content %}
{% from "macros/user_macros.html.j2" import user_display%}

<div class="container mt-5">

  <!-- User Profile Information Card -->
  <div class="card col-lg-8 mx-auto">
    <div class="row g-0 align-items-center">
      <div class="col-md-12">
        <div class="card-body">
          <h2 class="card-title">{{ user_display(user.username) }}</h2>
          <p class="card-text text-muted mb-3">
            <strong>Location:</strong> {{ user.location or "N/A" }}<br>
            <strong>Birthdate:</strong> {{ user.birthdate or "N/A" }}<br>
            <strong>Joined:</strong> {{ user.created_at|datetimeformat }}
          </p>
          <p class="card-text">{{ user.profile or "No profile information provided." }}</p>

         {% if session.user_id and session.user_id != user.id %}
            <div class="my-3">
              {# The logic is now a simple boolean check #}
              {% if is_following %}
                <form action="{{ url_for('unfollow_user', user_id=user.id) }}" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-secondary">Unfollow</button>
                </form>
              {% else %}
                <form action="{{ url_for('follow_user', user_id=user.id) }}" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-primary">Follow</button>
                </form>
              {% endif %}

              <!-- Private Message Button -->
              <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#chatModal-{{ user.id }}" onclick="loadChatHistory({{ user.id }})">
                💬 Private Message
              </button>
            </div>
          {% endif %}

          <!-- Private Message Modal Window -->
          <div class="modal fade" id="chatModal-{{ user.id }}" tabindex="-1" aria-labelledby="chatModalLabel-{{ user.id }}" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
              <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                  <h5 class="modal-title" id="chatModalLabel-{{ user.id }}">Chat with {{ user.username }}</h5>
                  <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                  <!-- Message Thread Box -->
                  <div id="chat-thread-{{ user.id }}" class="border rounded p-3 mb-3 bg-light" style="height: 350px; overflow-y: auto;">
                    <div class="text-center text-muted">Loading messages...</div>
                  </div>

                  <!-- Send Message Form -->
                  <form action="{{ url_for('send_message', recipient_id=user.id) }}" method="POST">
                    <div class="input-group">
                      <input type="text" name="content" class="form-control" placeholder="Type a private message..." required autocomplete="off">
                      <button type="submit" class="btn btn-primary">Send</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          </div>

          <!-- JavaScript to load message thread dynamically -->
          <script>
          function loadChatHistory(recipientId) {
            const threadBox = document.getElementById(`chat-thread-${recipientId}`);
            
            fetch(`/messages/${recipientId}`)
              .then(response => response.json())
              .then(data => {
                if (data.error) {
                  threadBox.innerHTML = `<div class="text-danger text-center">Please log in to view messages.</div>`;
                  return;
                }

                if (data.messages.length === 0) {
                  threadBox.innerHTML = `<div class="text-muted text-center mt-5">No private messages yet. Say hi!</div>`;
                  return;
                }

                threadBox.innerHTML = data.messages.map(msg => {
                  const isSelf = msg.sender_id === data.current_user_id;
                  return `
                    <div class="d-flex flex-column ${isSelf ? 'align-items-end' : 'align-items-start'} mb-2">
                      <div class="p-2 rounded ${isSelf ? 'bg-primary text-white' : 'bg-white border text-dark'}" style="max-width: 75%;">
                        <div>${msg.content}</div>
                      </div>
                      <small class="text-muted" style="font-size: 0.75rem;">${msg.sender_name}</small>
                    </div>
                  `;
                }).join('');

                // Auto-scroll to the latest message
                threadBox.scrollTop = threadBox.scrollHeight;
              })
              .catch(() => {
                threadBox.innerHTML = `<div class="text-danger text-center">Failed to load chat history.</div>`;
              });
          }
          </script>

          <div class="mt-4 d-flex">
            <div class="me-4">
              <a href="/u/{{ user.username }}/followers" class="text-decoration-none text-dark">
                <strong>{{ followers_count }}</strong> Followers
              </a>
            </div>
            <div>
              <a href="/u/{{ user.username }}/following" class="text-decoration-none text-dark">
                <strong>{{ following_count }}</strong> Following
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <h3 class="text-center border-bottom pb-2 my-5"><span>Latest Posts</span></h3>

  <div class="row g-3">
    {% for post in posts %}
    <div class="col-md-6">
      <div class="card h-100 shadow-sm card-hover">
        <a href="{{ url_for('post_detail', post_id=post.id) }}" class="text-decoration-none text-reset">
          <div class="card-body">
            <p class="card-text">{{ post.content|truncate(100, True, '...') }}</p>
            <small class="text-muted">Posted on {{ post.created_at|datetimeformat }}</small>
          </div>
        </a>
      </div>
    </div>
    {% else %}
    <div class="col-12">
      <p class="text-center text-muted">No posts yet.</p>
    </div>
    {% endfor %}
  </div>

  <!-- User's Latest Comments Section -->
  <h3 class="text-center border-bottom pb-2 my-5"><span>Latest Comments</span></h3>

  <div class="row g-3">
    {% for comment in comments %}
    <div class="col-md-6">
      <div class="card h-100 shadow-sm card-hover">
        <!-- The link now goes to the post the comment is on -->
        <a href="{{ url_for('post_detail', post_id=comment.post_id) }}" class="text-decoration-none text-reset">
          <div class="card-body">
            <!-- Display the comment content -->
            <p class="card-text">{{ comment.content|truncate(100, True, '...') }}</p>
            <!-- Updated text to show it's a comment -->
            <small class="text-muted">Commented on {{ comment.created_at|datetimeformat }}</small>
          </div>
        </a>
      </div>
    </div>
    {% else %}
    <div class="col-12">
      <p class="text-center text-muted">No comments yet.</p>
    </div>
    {% endfor %}
  </div>

  <!-- Achievements Section -->
  <div class="card col-lg-8 mx-auto mt-4 shadow-sm">
  <div class="card-body">
    <h4 class="card-title mb-4">🏆 Achievements & Progress</h4>

    <!-- Posts Achievement -->
    <div class="mb-4">
      <div class="d-flex justify-content-between align-items-center mb-1">
        <strong>Posts Level {{ post_stats.level }}</strong>
        <span class="text-muted small">
          {{ post_stats.current_count }} out of {{ post_stats.next_goal }} posts
          ({{ post_stats.remaining }} needed for Level {{ post_stats.level + 1 }})
        </span>
      </div>
      <div class="progress" style="height: 18px;">
        <div class="progress-bar bg-primary" role="progressbar" 
             style="width: {{ post_stats.percentage }}%;" 
             aria-valuenow="{{ post_stats.percentage }}" 
             aria-valuemin="0" aria-valuemax="100">
          {{ post_stats.percentage }}%
        </div>
      </div>
    </div>

    <!-- Comments Achievement -->
    <div>
      <div class="d-flex justify-content-between align-items-center mb-1">
        <strong>Comments Level {{ comment_stats.level }}</strong>
        <span class="text-muted small">
          {{ comment_stats.current_count }} out of {{ comment_stats.next_goal }} comments
          ({{ comment_stats.remaining }} needed for Level {{ comment_stats.level + 1 }})
        </span>
      </div>
      <div class="progress" style="height: 18px;">
        <div class="progress-bar bg-success" role="progressbar" 
             style="width: {{ comment_stats.percentage }}%;" 
             aria-valuenow="{{ comment_stats.percentage }}" 
             aria-valuemin="0" aria-valuemax="100">
          {{ comment_stats.percentage }}%
        </div>
      </div>
    </div>

  </div>
</div>

</div>
{% endblock %}
